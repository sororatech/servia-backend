# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For local Docker, leave DATABASE_URL commented out and use the POSTGRES_* vars below.
# For Supabase (production/staging), set DATABASE_URL and comment out POSTGRES_* vars.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
POSTGRES_DB=servia
POSTGRES_USER=servia
POSTGRES_PASSWORD=servia123

# Redis (local Docker)
REDIS_URL=redis://redis:6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Email (Resend)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-smtp-password-here
RESEND_API_KEY=your-resend-api-key-here
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare R2
CLOUDFLARE_API_KEY=your-cloudflare-api-key-here
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key-here
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key-here
CLOUDFLARE_R2_BUCKET=servia-cv-storage
CLOUDFLARE_R2_PUBLIC_URL=your-r2-public-url-here
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id-here
